# AI Provider Configuration
# Set ONE of the following API keys; the service will auto-detect which provider to use.
# You can also force a provider with AI_PROVIDER (values: openai, anthropic, google, mock, auto)

# OpenAI
OPENAI_API_KEY=
# Model examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# AI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Model examples: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# AI_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini)
GOOGLE_API_KEY=
# Model examples: gemini-1.5-flash, gemini-1.5-pro
# AI_MODEL=gemini-1.5-flash

# Force provider selection (optional, default: auto)
# AI_PROVIDER=auto
